{
  "id": "eventia-apple-pwa-v2",
  "name": "EVENTIA Pro — Salones, Cotizaciones & Mapas",
  "short_name": "EVENTIA",
  "description": "Plataforma SaaS Apple Experience para administración de salones de eventos, cotizaciones personalizadas, mapas nativos y pagos con Mercado Pago.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Personalizar Cotización",
      "short_name": "Cotizar",
      "description": "Crear cotización con presupuesto, WhatsApp y Mercado Pago",
      "url": "/quotes/new",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Salones y Mapas GPS",
      "short_name": "Mapas",
      "description": "Ver ubicación de salones y abrir Apple Maps o Google Maps",
      "url": "/venues",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Agenda de Eventos",
      "short_name": "Agenda",
      "description": "Consultar calendario mensual de eventos",
      "url": "/calendar",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
